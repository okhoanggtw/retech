digraph G {
  graph [rankdir=LR, fontname="Noto Sans", pad=0.3, nodesep=0.18, ranksep=1.6, bgcolor=white, newrank=true,
         label="Ký hiệu:  ○ tiến trình   ▭ tác nhân ngoài   ═ kho dữ liệu   → luồng dữ liệu.   Tác nhân / kho xuất hiện nhiều lần là cùng một đối tượng, vẽ lặp lại cho dễ đọc.", labelloc=b, fontsize=11];
  node  [fontname="Noto Sans", fontsize=12, color=black, penwidth=1.2];
  edge  [fontname="Noto Sans", fontsize=9.5, color=black, arrowsize=0.65];

  P0 [shape=circle, fixedsize=true, width=1.55, style=filled, fillcolor="#F2F2F2", label="1.0\nQuản lý\ntài khoản"];
  E0_0 [shape=box, width=1.6, height=0.55, label="Khách hàng"];
  E0_0 -> P0 [label="Thông tin đăng ký, đăng nhập"];
  E0_0 -> P0 [label="Token, hồ sơ", dir=back];
  E0_1 [shape=box, width=1.6, height=0.55, label="Quản trị viên"];
  E0_1 -> P0 [label="Phân quyền, khóa tài khoản"];
  S0_2 [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td sides="r"><b>D1</b></td><td sides="tb" width="130">Người dùng</td></tr></table>>];
  P0 -> S0_2 [label="Tài khoản"];
  P0 -> S0_2 [label="Thông tin người dùng", dir=back];
  P1 [shape=circle, fixedsize=true, width=1.55, style=filled, fillcolor="#F2F2F2", label="2.0\nQuản lý\nsản phẩm"];
  E1_0 [shape=box, width=1.6, height=0.55, label="Khách hàng"];
  E1_0 -> P1 [label="Từ khóa, bộ lọc"];
  E1_0 -> P1 [label="Sản phẩm, gợi ý mua kèm", dir=back];
  E1_1 [shape=box, width=1.6, height=0.55, label="Quản trị viên"];
  E1_1 -> P1 [label="Thông tin sản phẩm, SP mua kèm"];
  E1_1 -> P1 [label="Giá bán gợi ý", dir=back];
  E1_2 [shape=box, width=1.6, height=0.55, label="Google Gemini"];
  E1_2 -> P1 [label="Thông số máy", dir=back];
  E1_2 -> P1 [label="Giá đề xuất"];
  S1_3 [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td sides="r"><b>D2</b></td><td sides="tb" width="130">Sản phẩm, danh mục</td></tr></table>>];
  P1 -> S1_3 [label="Sản phẩm mới, cập nhật"];
  P1 -> S1_3 [label="Thông tin sản phẩm", dir=back];
  S1_4 [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td sides="r"><b>D4</b></td><td sides="tb" width="130">Đơn hàng</td></tr></table>>];
  P1 -> S1_4 [label="SP thường mua cùng", dir=back];
  P2 [shape=circle, fixedsize=true, width=1.55, style=filled, fillcolor="#F2F2F2", label="3.0\nQuản lý\nbán hàng"];
  E2_0 [shape=box, width=1.6, height=0.55, label="Khách hàng"];
  E2_0 -> P2 [label="Giỏ hàng, địa chỉ, mã KM"];
  E2_0 -> P2 [label="Hóa đơn, mã QR, trạng thái", dir=back];
  E2_1 [shape=box, width=1.6, height=0.55, label="Quản trị viên"];
  E2_1 -> P2 [label="Cập nhật trạng thái đơn"];
  E2_1 -> P2 [label="Danh sách đơn hàng", dir=back];
  E2_2 [shape=box, width=1.6, height=0.55, label="PayOS"];
  E2_2 -> P2 [label="Yêu cầu tạo link TT", dir=back];
  E2_2 -> P2 [label="QR, kết quả giao dịch"];
  S2_3 [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td sides="r"><b>D2</b></td><td sides="tb" width="130">Sản phẩm, danh mục</td></tr></table>>];
  P2 -> S2_3 [label="Giá, tồn kho", dir=back];
  P2 -> S2_3 [label="Trừ / hoàn kho"];
  S2_4 [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td sides="r"><b>D3</b></td><td sides="tb" width="130">Giỏ hàng</td></tr></table>>];
  P2 -> S2_4 [label="Giỏ hàng", dir=back];
  S2_5 [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td sides="r"><b>D5</b></td><td sides="tb" width="130">Khuyến mãi</td></tr></table>>];
  P2 -> S2_5 [label="Mã khuyến mãi", dir=back];
  S2_6 [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td sides="r"><b>D4</b></td><td sides="tb" width="130">Đơn hàng</td></tr></table>>];
  P2 -> S2_6 [label="Đơn hàng, trạng thái"];
  P2 -> S2_6 [label="Đơn hàng", dir=back];
  P3 [shape=circle, fixedsize=true, width=1.55, style=filled, fillcolor="#F2F2F2", label="4.0\nThu mua\nmáy cũ"];
  E3_0 [shape=box, width=1.6, height=0.55, label="Khách hàng"];
  E3_0 -> P3 [label="Thông tin máy cũ, liên hệ"];
  E3_0 -> P3 [label="Giá định giá", dir=back];
  E3_1 [shape=box, width=1.6, height=0.55, label="Quản trị viên"];
  E3_1 -> P3 [label="Giá thu, trạng thái"];
  E3_1 -> P3 [label="Yêu cầu thu mua", dir=back];
  E3_2 [shape=box, width=1.6, height=0.55, label="Google Gemini"];
  E3_2 -> P3 [label="Thông tin máy", dir=back];
  E3_2 -> P3 [label="Giá ước tính"];
  S3_3 [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td sides="r"><b>D2</b></td><td sides="tb" width="130">Sản phẩm, danh mục</td></tr></table>>];
  P3 -> S3_3 [label="Giá máy tương tự", dir=back];
  S3_4 [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td sides="r"><b>D6</b></td><td sides="tb" width="130">Yêu cầu thu mua</td></tr></table>>];
  P3 -> S3_4 [label="Yêu cầu thu mua"];
  P3 -> S3_4 [label="Yêu cầu", dir=back];
  P4 [shape=circle, fixedsize=true, width=1.55, style=filled, fillcolor="#F2F2F2", label="5.0\nHỗ trợ\nkhách hàng"];
  E4_0 [shape=box, width=1.6, height=0.55, label="Khách hàng"];
  E4_0 -> P4 [label="Câu hỏi, liên hệ"];
  E4_0 -> P4 [label="Câu trả lời, FAQ", dir=back];
  E4_1 [shape=box, width=1.6, height=0.55, label="Quản trị viên"];
  E4_1 -> P4 [label="Liên hệ mới", dir=back];
  E4_1 -> P4 [label="Đánh dấu đã xử lý"];
  E4_2 [shape=box, width=1.6, height=0.55, label="Google Gemini"];
  E4_2 -> P4 [label="Câu hỏi + ngữ cảnh SP", dir=back];
  E4_2 -> P4 [label="Câu trả lời"];
  S4_3 [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td sides="r"><b>D2</b></td><td sides="tb" width="130">Sản phẩm, danh mục</td></tr></table>>];
  P4 -> S4_3 [label="Sản phẩm phù hợp", dir=back];
  S4_4 [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td sides="r"><b>D8</b></td><td sides="tb" width="130">Nội dung, cài đặt</td></tr></table>>];
  P4 -> S4_4 [label="FAQ, thông tin shop", dir=back];
  S4_5 [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td sides="r"><b>D7</b></td><td sides="tb" width="130">Liên hệ, lịch sử chat</td></tr></table>>];
  P4 -> S4_5 [label="Liên hệ, lịch sử chat"];
  P5 [shape=circle, fixedsize=true, width=1.55, style=filled, fillcolor="#F2F2F2", label="6.0\nQuản trị\nnội dung,\nbáo cáo"];
  E5_0 [shape=box, width=1.6, height=0.55, label="Quản trị viên"];
  E5_0 -> P5 [label="Banner, menu, KM, FAQ, cài đặt"];
  E5_0 -> P5 [label="Báo cáo thống kê", dir=back];
  E5_1 [shape=box, width=1.6, height=0.55, label="PayOS"];
  E5_1 -> P5 [label="Đăng ký webhook", dir=back];
  S5_2 [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td sides="r"><b>D8</b></td><td sides="tb" width="130">Nội dung, cài đặt</td></tr></table>>];
  P5 -> S5_2 [label="Nội dung, cài đặt"];
  S5_3 [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td sides="r"><b>D5</b></td><td sides="tb" width="130">Khuyến mãi</td></tr></table>>];
  P5 -> S5_3 [label="Khuyến mãi"];
  S5_4 [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td sides="r"><b>D4</b></td><td sides="tb" width="130">Đơn hàng</td></tr></table>>];
  P5 -> S5_4 [label="Doanh thu, SP bán chạy", dir=back];
  {rank=same; E0_0; E0_1; E1_0; E1_1; E1_2; E2_0; E2_1; E2_2; E3_0; E3_1; E3_2; E4_0; E4_1; E4_2; E5_0; E5_1}
  {rank=same; P0; P1; P2; P3; P4; P5}
  {rank=same; S0_2; S1_3; S1_4; S2_3; S2_4; S2_5; S2_6; S3_3; S3_4; S4_3; S4_4; S4_5; S5_2; S5_3; S5_4}
  P0 -> P1 -> P2 -> P3 -> P4 -> P5 [style=invis];
}